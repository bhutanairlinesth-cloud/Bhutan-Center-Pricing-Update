{
  "name": "bhutan-center-unified",
  "version": "13.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:admin": "vite --config admin-app/vite.config.ts",
    "build:admin": "vite build --config admin-app/vite.config.ts",
    "build": "npm run preflight && npm run build:admin && next build",
