{
  "name": "bhutan-center-unified",
  "private": true,
  "version": "13.14.9",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:admin": "vite --config admin-app/vite.config.ts --host 0.0.0.0 --port 3001",
    "prebuild": "node scripts/preflight.mjs",
    "build:admin": "vite build --config admin-app/vite.config.ts",
    "build": "npm run build:admin && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.78.0",
    "lucide-react": "0.546.0",
    "next": "15.5.24",
    "react": "19.0.1",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.8.2",
    "vite": "6.2.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
